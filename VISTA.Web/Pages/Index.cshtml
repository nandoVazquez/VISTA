@page
@model IndexModel
<!--Creates the Dashboard-->
@using VISTA.Models
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Dashboard</h1>
    @if (HttpContext.Session.GetString("Role") == "User")
    {
        <a href="/Create" class="btn btn-primary">New Request</a>
    }
</div>

<!-- Status Filter -->

<form method="get">
    <div class="d-flex align-items-center gap-3 mb-3">
        <div class ="input-group" style="width: max-content;">
            <label class="input-group-text" for="statusFilter">Filter by:</label>
            <select class="form-select w-auto" id="statusFilter" name="status" onchange="this.form.submit()">
                <option value="" selected="@(Model.SelectedStatus == "")">All Status</option>
                <option value="Draft" selected="@(Model.SelectedStatus == "Draft")">Draft</option>
                <option value="Submitted" selected="@(Model.SelectedStatus == "Submitted")">Submitted</option>
                <option value="Approved" selected="@(Model.SelectedStatus == "Approved")">Approved</option>
                <option value="Denied" selected="@(Model.SelectedStatus == "Denied")">Denied</option>
                <option value="Expired" selected="@(Model.SelectedStatus == "Expired")">Expired</option>
            </select>
        </div>
        <div class="d-flex gap-2 align-items-center"> 
            <span class="badge badge-draft fs-6 px-3 py-2">Draft: @Model.DraftCount</span>
            <span class="badge badge-submitted fs-6 px-3 py-2">Submitted: @Model.SubmittedCount</span>
            <span class="badge badge-approved fs-6 px-3 py-2">Approved: @Model.ApprovedCount</span>
            <span class="badge badge-denied fs-6 px-3 py-2">Denied: @Model.DeniedCount</span>
            <span class="badge badge-expired fs-6 px-3 py-2">Expired: @Model.ExpiredCount</span>
        </div>
        <div class="flex-grow-1"></div>
        <div class="input-group" style="width: 300px;">
            <input type="text" class="form-control" name="search"
                placeholder="Search..."
                value="@Model.SearchTerm" />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/Index" class="btn btn-outline-danger">✕</a>
            }
        </div>
    </div>
</form>


<!-- Table Role check happens in OnGet()-->
<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Visitor</th>
            <th>Organization</th>
            <th>Visit Dates</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    
    <!-- For each goes through each var and sets everything-->
    <tbody>
        @foreach (var item in Model.VarList)
        {
            <tr>
                <td>@item.VisitorName</td>
                <td>@item.VisitorOrganization</td>
                <td>@item.VisitStartDate.ToShortDateString() to @item.VisitEndDate.ToShortDateString()</td>
                <td><span class="badge @item.StatusBadgeClass">@item.Status</span></td>
                <td>@item.CreatedDate.ToShortDateString()</td>
                <td>
                    <a href="/Details?id=@item.ID" class="btn btn-sm btn-outline-secondary">View</a>

                    <!-- Edit button only shows up for Submitted and Draft and delete for juts draft-->

                    @if (item.Status == RequestStatus.Draft)
                    {
                        if (HttpContext.Session.GetString("Role") == "User")
                        {
                            <a href="/Edit?id=@item.ID" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form method="post" asp-page-handler="Delete" class="d-inline"
                            onsubmit="return confirm('Are you sure you want to delete this request?');">
                                <input type="hidden" name="id" value="@item.ID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    }
                    @if (item.Status == RequestStatus.Submitted)
                    {
                        if (HttpContext.Session.GetString("Role") == "User")
                        {
                            <a href="/Edit?id=@item.ID" class="btn btn-sm btn-outline-primary">Edit</a>
                        }
                    }


                </td>
            </tr>
        }
    </tbody>    
</table>
