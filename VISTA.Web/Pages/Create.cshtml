@page
@model VISTA.Web.Pages.CreateModel

@{
    ViewData["Title"] = "New Request";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">New Request</h1>
</div>
<!-- The Form -->
<div class="card">
    <div class="card-body">
        <form method="post">

            <!-- Visitor Infromation -->
            <h5 class="mb-3">Visitor Information</h5>
            
            <div class="mb-3">
                <label class="form-label fw-semibold">Visitor Name</label>
                <input type="text" class="form-control" asp-for="VAR.VisitorName"
                       placeholder="Full name of the visitor" required
                       maxlength="100"/>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Visitor Organization</label>
                <input type="text" class="form-control" asp-for="VAR.VisitorOrganization"
                       placeholder="Company, Agency, or Organization" required maxlength="100" />
            </div>



            <hr class="my-4" />
            
            <!-- Sponsor Infromation -->
            <h5 class="mb-3">Sponsor Information</h5>

            <div class="mb-3">
                <label class="form-label fw-semibold">Sponsor Name</label>
                <input type="text" class="form-control" asp-for="VAR.SponsorName"
                       placeholder="Full name of the sponsor" required maxlength="100" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Sponsor Email</label>
                <input type="email" class="form-control" asp-for="VAR.SponsorEmail"
                       placeholder="sponsor@email.com" required maxlength="100" />
            </div>

            <hr class="my-4" />

            <h5 class="mb-3">Visit Details</h5>

            <div class="mb-3">
                <label class="form-label fw-semibold">Purpose of Visit</label>
                <textarea class="form-control" asp-for="VAR.VisitPurpose" rows="3"
                          placeholder="Brief description of the reason for visit"
                          required maxlength="500"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Visit Start Date</label>
                    <input type="date" class="form-control" asp-for="VAR.VisitStartDate" value = "" required/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Visit End Date</label>
                    <input type="date" class="form-control" asp-for="VAR.VisitEndDate" value = "" required>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Form Buttons -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Draft" formnovalidate>Save Draft</button>
                <button type="submit" class="btn btn-primary ms-auto "asp-page-handler="Submit">Submit Request</button>
            </div>
        </form>
    </div>
</div>

<!-- BACK BUTTON — bottom left -->
<div class="mt-3">
    <a href="/Index" class="btn btn-outline-secondary">Back</a>
</div>